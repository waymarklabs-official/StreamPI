{
  "manifest_version": 3,
  "name": "Remote D-pad",
  "version": "2.0",
  "description": "Arrow keys jump between clickable things; Enter clicks. For a TV remote.",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["hide-cursor.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["*://www.youtube.com/tv*"],
      "js": ["dpad.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "css": ["dark-start.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "css": ["hide-scrollbars.css"],
      "run_at": "document_start"
    }
  ]
}
