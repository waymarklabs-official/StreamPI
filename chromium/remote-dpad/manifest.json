{
  "manifest_version": 3,
  "name": "Remote D-pad",
  "version": "1.4",
  "description": "Arrow keys jump between clickable things; Enter clicks. For a TV remote.",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["hide-cursor.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["*://open.spotify.com/*"],
      "js": ["dpad.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://open.spotify.com/*"],
      "css": ["spotify-focus.css"]
    },
    {
      "matches": ["<all_urls>"],
      "css": ["hide-scrollbars.css"],
      "run_at": "document_start"
    }
  ]
}
