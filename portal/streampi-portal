#!/usr/bin/env python3
"""StreamPI WiFi onboarding portal.

Runs before Kodi. If the Pi already has connectivity it exits immediately.
Otherwise it raises a WPA2 hotspot, shows the network name, password and a
join-QR on the TV, and serves a phone-friendly picker that writes a permanent
NetworkManager profile.

One hardware constraint shapes the whole design: the Pi's single radio cannot
scan for networks while it is acting as an access point. So the scan happens
*before* the hotspot comes up and the results are cached for the portal to
serve. "Rescan" therefore has to drop the AP, scan, and bring it back, which
kicks the phone off -- so the UI offers manual SSID entry instead.
"""

import html
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import time
import urllib.parse
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

AP_ADDR = "10.42.0.1"          # NetworkManager's default for shared mode
AP_SSID = "StreamPI-Setup"
PORTAL_PORT = 80
CONNECT_TIMEOUT = 45           # seconds to wait for the chosen network
STATE_DIR = "/run/streampi"
TTY = "/dev/tty1"

# URLs each OS probes to decide whether it is behind a captive portal. Answering
# these with a redirect is what makes the "Sign in to network" sheet pop up on
# the phone instead of the user having to open a browser and guess an address.
PROBE_PATHS = {
    "/generate_204", "/gen_204",                      # Android
    "/hotspot-detect.html", "/library/test/success.html",  # iOS / macOS
    "/ncsi.txt", "/connecttest.txt",                  # Windows
    "/canonical.html", "/success.txt",                # Firefox / misc
}

_scan_cache = []
_server = None
_connected = False


def run(args, **kw):
    kw.setdefault("capture_output", True)
    kw.setdefault("text", True)
    kw.setdefault("timeout", 60)
    try:
        return subprocess.run(args, **kw)
    except (OSError, subprocess.SubprocessError) as exc:
        log(f"command failed: {' '.join(args)}: {exc}")
        return subprocess.CompletedProcess(args, 1, "", str(exc))


def log(msg):
    print(f"[streampi-portal] {msg}", flush=True)


def wifi_device():
    out = run(["nmcli", "-t", "-f", "DEVICE,TYPE", "device"]).stdout
    for line in out.splitlines():
        parts = line.split(":")
        if len(parts) >= 2 and parts[1] == "wifi":
            return parts[0]
    return None


def has_connectivity():
    """True on a real route to the internet, not merely an IP address.

    "portal" counts too: a ship or hotel network that wants a browser login is
    still the right network, and the Wi-Fi Login tile in Kodi handles the
    login. Treating it as offline would tear down a working connection.
    """
    out = run(["nmcli", "-t", "-f", "CONNECTIVITY", "general"]).stdout.strip()
    return out in ("full", "portal")


def ap_password():
    """Stable per-device passphrase so the QR on screen keeps working."""
    serial = ""
    try:
        with open("/proc/cpuinfo") as fh:
            for line in fh:
                if line.startswith("Serial"):
                    serial = line.split(":")[1].strip()
                    break
    except OSError:
        pass
    if not serial:
        serial = run(["cat", "/etc/machine-id"]).stdout.strip()
    # Last 8 hex digits, uppercased: short enough to retype, long enough that a
    # neighbour cannot guess their way onto the setup AP and redirect the box.
    tail = (serial or "0000000000000000")[-8:].upper()
    return f"stream{tail}"


def scan_networks():
    """Scan and return [{ssid, signal, secure}], strongest first, deduplicated."""
    dev = wifi_device()
    if not dev:
        return []
    run(["nmcli", "device", "wifi", "rescan"], timeout=30)
    time.sleep(4)  # the scan is asynchronous; results trickle in
    out = run([
        "nmcli", "-t", "-f", "SSID,SIGNAL,SECURITY", "device", "wifi", "list"
    ]).stdout

    best = {}
    for line in out.splitlines():
        # nmcli escapes colons inside fields as "\:" -- split on unescaped ones.
        fields = re.split(r"(?<!\\):", line)
        if len(fields) < 3:
            continue
        ssid = fields[0].replace("\\:", ":").strip()
        if not ssid:
            continue  # hidden network; user can type it manually
        try:
            signal = int(fields[1])
        except ValueError:
            signal = 0
        secure = fields[2].strip() not in ("", "--")
        if ssid not in best or signal > best[ssid]["signal"]:
            best[ssid] = {"ssid": ssid, "signal": signal, "secure": secure}
    return sorted(best.values(), key=lambda n: -n["signal"])


def install_wildcard_dns():
    """Point every hostname at us so any URL the phone opens hits the portal.

    NetworkManager runs its own dnsmasq for shared connections and reads extra
    config from this directory, so we do not have to manage dnsmasq ourselves.
    """
    d = "/etc/NetworkManager/dnsmasq-shared.d"
    os.makedirs(d, exist_ok=True)
    with open(os.path.join(d, "streampi-portal.conf"), "w") as fh:
        fh.write(
            "# StreamPI: resolve all names to the portal while the setup AP is up.\n"
            f"address=/#/{AP_ADDR}\n"
        )


def start_ap():
    dev = wifi_device()
    if not dev:
        log("no wifi device; cannot start setup AP")
        return False
    # A system-wide hostapd or dnsmasq grabs the radio and ports 53/67 that
    # NetworkManager's hotspot needs. Say so plainly instead of failing oddly.
    for svc in ("hostapd", "dnsmasq"):
        if run(["systemctl", "is-active", "--quiet", svc]).returncode == 0:
            log(f"{svc}.service is running and will block the setup AP; "
                f"disable it with: sudo systemctl disable --now {svc}")
    install_wildcard_dns()
    run(["nmcli", "connection", "delete", "streampi-ap"])  # clear a stale one
    res = run([
        "nmcli", "device", "wifi", "hotspot",
        "ifname", dev, "con-name", "streampi-ap",
        "ssid", AP_SSID, "password", ap_password(),
    ])
    if res.returncode != 0:
        log(f"failed to start hotspot: {res.stderr.strip()}")
        return False
    log(f"setup AP up: SSID={AP_SSID} at {AP_ADDR}")
    return True


def stop_ap():
    run(["nmcli", "connection", "down", "streampi-ap"])
    run(["nmcli", "connection", "delete", "streampi-ap"])
    try:
        os.remove("/etc/NetworkManager/dnsmasq-shared.d/streampi-portal.conf")
    except OSError:
        pass


def show_on_tv():
    """Paint setup instructions and a join-QR on the HDMI console."""
    pw = ap_password()
    qr = ""
    if shutil.which("qrencode"):
        # WIFI: URI -- scanning it joins the hotspot without typing the password.
        payload = f"WIFI:T:WPA;S:{AP_SSID};P:{pw};;"
        qr = run(["qrencode", "-t", "ANSIUTF8", "-m", "2", payload]).stdout

    screen = (
        "\033[2J\033[H"                      # clear, home
        "\033[1;36m"
        "        S T R E A M P I\n\n"
        "\033[0m"
        "  Let's get you on WiFi.\n\n"
        "  1. On your phone, scan this code\n"
        "     (or join the network by hand)\n\n"
        f"{qr}\n"
        f"  Network:  \033[1m{AP_SSID}\033[0m\n"
        f"  Password: \033[1m{pw}\033[0m\n\n"
        "  2. A setup page opens automatically.\n"
        "     If it doesn't, visit\n"
        f"     \033[1mhttp://{AP_ADDR}\033[0m\n\n"
        "  Kodi starts as soon as you're online.\n"
    )
    try:
        with open(TTY, "w") as tty:
            tty.write(screen)
    except OSError as exc:
        # Headless or no console access -- not fatal, the portal still works.
        log(f"could not draw on {TTY}: {exc}")


def clear_tv(message):
    try:
        with open(TTY, "w") as tty:
            tty.write("\033[2J\033[H\033[1;32m" + message + "\033[0m\n")
    except OSError:
        pass


PAGE = """<!doctype html>
