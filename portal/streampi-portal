class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, fmt, *args):
        pass  # keep the journal readable

    def _send(self, code, body=b"", ctype="text/html; charset=utf-8", extra=None):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        for k, v in (extra or {}).items():
            self.send_header(k, v)
        self.end_headers()
        if body:
            self.wfile.write(body)

    def do_GET(self):
        path = urllib.parse.urlparse(self.path).path
        if path in PROBE_PATHS:
            # 302 rather than 204: the redirect is what opens the sign-in sheet.
            self._send(302, b"", extra={"Location": f"http://{AP_ADDR}/"})
            return
        if path == "/scan.json":
            self._send(200, json.dumps(_scan_cache).encode(), "application/json")
            return
        if path in ("/", "/index.html"):
            self._send(200, PAGE.encode())
            return
        self._send(302, b"", extra={"Location": f"http://{AP_ADDR}/"})

    def do_POST(self):
        global _connected
        if urllib.parse.urlparse(self.path).path != "/connect":
            self._send(404, b"not found")
            return
        try:
            length = int(self.headers.get("Content-Length", 0))
        except ValueError:
            length = 0
        if length <= 0 or length > 4096:
            self._send(400, b'{"ok":false,"error":"bad request"}', "application/json")
            return
        form = urllib.parse.parse_qs(self.rfile.read(length).decode("utf-8", "replace"))
        ssid = (form.get("ssid", [""])[0]).strip()
        psk = form.get("psk", [""])[0]

        if not ssid:
            self._send(400, b'{"ok":false,"error":"Network name is required."}',
                       "application/json")
            return
        if psk and not 8 <= len(psk) <= 63:
            self._send(200,
                       b'{"ok":false,"error":"WPA passwords are 8-63 characters."}',
                       "application/json")
            return

        log(f"attempting connection to {ssid!r}")
        # Answer before tearing down the AP, otherwise the phone never sees the
        # response -- its route to us disappears with the hotspot.
        self._send(200, b'{"ok":true}', "application/json")
        try:
            self.wfile.flush()
        except OSError:
            pass

        if try_connect(ssid, psk):
            _connected = True
            if _server:
                # Shut the server from another thread; calling it from the
                # handler would deadlock.
                import threading
                threading.Thread(target=_server.shutdown, daemon=True).start()


def try_connect(ssid, psk):
    stop_ap()
    time.sleep(2)  # let the radio settle out of AP mode
    dev = wifi_device()
    args = ["nmcli", "device", "wifi", "connect", ssid]
    if psk:
        args += ["password", psk]
    if dev:
        args += ["ifname", dev]
    res = run(args, timeout=CONNECT_TIMEOUT)
    if res.returncode != 0:
        log(f"connect failed: {res.stderr.strip()}")
        return False

    deadline = time.time() + 25
    while time.time() < deadline:
        if has_connectivity():
            log(f"connected to {ssid!r}")
            return True
        time.sleep(2)
    log("associated but no internet route")
    return False


def main():
    os.makedirs(STATE_DIR, exist_ok=True)

    if has_connectivity():
        log("already online; nothing to do")
        return 0

    log("no connectivity; starting onboarding")
    global _scan_cache, _server
    # Must happen before the AP comes up: one radio cannot scan and beacon.
    _scan_cache = scan_networks()
    log(f"found {len(_scan_cache)} networks")

    if not start_ap():
        clear_tv("WiFi setup could not start. Plug in Ethernet, or\n"
                 "check `journalctl -u streampi-portal`.")
        return 1
    show_on_tv()

    _server = ThreadingHTTPServer(("0.0.0.0", PORTAL_PORT), Handler)
    _server.daemon_threads = True

    def bail(signum, frame):
        if _server:
            _server.shutdown()
    signal.signal(signal.SIGTERM, bail)
    signal.signal(signal.SIGINT, bail)

    log(f"portal listening on {AP_ADDR}:{PORTAL_PORT}")
    try:
        _server.serve_forever()
    finally:
        _server.server_close()
        stop_ap()

    if _connected:
        clear_tv("Connected. Starting Kodi…\n"
                 "If this network has a login page, open Wi-Fi Login in Kodi.")
        return 0
    clear_tv("WiFi setup ended without connecting.")
    return 1


if __name__ == "__main__":
    sys.exit(main())
